VITE_API_BASE=/api
VITE_API_TOKEN=

# ESA Edge Function secret. If set, /api/track and POST /api/download require the same value.
CPE_STATS_TOKEN=

# Optional ESA Edge Function secret for AMap WebService reverse geocoding.
# If set, Chinese visitor coordinates can be normalized to official Chinese province/city names.
AMAP_WEB_SERVICE_KEY=

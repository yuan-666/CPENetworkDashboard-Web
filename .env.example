VITE_API_BASE=/api

# Do not put CPE_STATS_TOKEN, CPE_ANALYTICS_TOKEN, or AMAP_WEB_SERVICE_KEY here.
# ESA passes frontend env only at build time. Runtime secrets/config belong in EdgeKV:
# key: config
# value:
# {
#   "CPE_STATS_TOKEN": "long-random-write-and-publish-token",
#   "CPE_ANALYTICS_TOKEN": "analytics-page-password-token",
#   "AMAP_WEB_SERVICE_KEY": "optional-amap-webservice-key"
# }
